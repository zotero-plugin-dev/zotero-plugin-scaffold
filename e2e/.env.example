# Copy this file to `e2e/.env` to run the suite against a real Zotero.
#
# `e2e/.env` is git-ignored, and `helpers/cli.ts` loads it into the environment
# of every command the suite runs. In CI the same variables come from
# `zotero-plugin-dev/setup-zotero`, so nothing has to be created there.
#
# Only `serve.test.ts` and `zotest.test.ts` need Zotero; the other files do not.
# Without a Zotero those two fail with "Zotero binary not found" — by design,
# see the note at the top of either file.

# The Zotero binary.
# Linux: `/path/to/zotero`; 
# macOS: `/Applications/Zotero.app/Contents/MacOS/zotero`; 
# Windows: # `D:/Program Files/Zotero/zotero.exe`.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=

# Set to anything to run with a visible Zotero window. The fixture passes
# `-headless` otherwise, so a run pops nothing up.
# E2E_HEADED=1
