{
  "name": "zotero-plugin-scaffold-monorepo",
  "type": "module",
  "version": "0.9.4",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "Monorepo for zotero-plugin-scaffold.",
  "author": "northword",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://scaffold.zotero-plugin.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/zotero-plugin-dev/zotero-plugin-scaffold.git"
  },
  "bugs": {
    "url": "https://github.com/zotero-plugin-dev/zotero-plugin-scaffold/issues"
  },
  "engines": {
    "node": ">=22.8.0"
  },
  "scripts": {
    "dev": "tsdown -W --watch",
    "build": "pnpm build:tsdown && pnpm build:tsc",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "pnpm -C docs run dev",
    "docs:build": "pnpm -C docs run build",
    "release": "bumpp -r --commit \"chore(release): publish v%s\"",
    "update:deps": "pnpx taze minor -w -f -l -r",
    "test": "vitest",
    "prepare": "husky",
    "build:tsdown": "tsdown -W",
    "build:tsc": "pnpm -r build:tsc"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/native": "catalog:dev",
    "bumpp": "catalog:",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
