{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["node"],
    "outDir": "dist",
    // Only the packages emit declarations, so root-level config files
    // (tsdown.config.ts, vitest.config.ts) don't need it.
    "isolatedDeclarations": false
  },
  "include": [
    "*.ts",
    "typings"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
